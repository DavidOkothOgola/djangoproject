SECRET_KEY=my_secret_key
DEBUG=True

# ALLOWED_HOSTS=yourdomain.com,anotherdomain.com (Each host is separated by a comma)
ALLOWED_HOSTS=*

DARAJA_ENVIRONMENT=sandbox
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=your_daraja_passkey
DARAJA_CALLBACK_URL=https://example.com/payments/mpesa/callback/
PAYMENT_GATEWAY_NAME=Stripe
DARAJA_DEMO_SESSION_REFERENCE=DASH-LEGAL-2048
DARAJA_DEMO_AMOUNT=2250
DARAJA_DEMO_PHONE_NUMBER=254700123456

# Django Channels / Redis
CHANNEL_LAYER_BACKEND=channels_redis.core.RedisChannelLayer
REDIS_URL=redis://localhost:6379

# Daraja API credentials (Safaricom developer portal)
DARAJA_CONSUMER_KEY=your_daraja_consumer_key
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret

# Platform fees (KES)
PLATFORM_SUBSCRIPTION_FEE=400
PLATFORM_TRANSACTION_FEE=20

# PostgreSQL (optional – uses SQLite by default)
DATABASE_URL=

# S3 / Cloudflare R2 media storage (optional – uses local storage by default)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
